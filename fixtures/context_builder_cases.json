{
  "spec": "Golden cases for the context builder (docs/design_doc.md §5.2, src/modeling/context.py). Any reimplementation (e.g., the serving path) must reproduce `expected` exactly. Token counts use `token_counter`; 'whitespace' = number of whitespace-separated pieces. Every speaker or channel tag costs 1 token; overhead is 3 ([CLS], [SEP], [SEP]). `config` fields override defaults: token_budget 256, lookback_messages 50. Edit expected values only when the builder's behavior intentionally changes.",
  "token_counter": "whitespace",
  "cases": [
    {
      "name": "empty_history_dm",
      "description": "No earlier messages: context is just the channel tag.",
      "channel_type": "direct",
      "config": {},
      "history": [],
      "target": {
        "speaker_id": "a",
        "text": "hi"
      },
      "expected": {
        "context_text": "[DM]",
        "target_text": "hi",
        "total_tokens": 5,
        "n_context_messages": 0,
        "n_speakers": 1
      }
    },
    {
      "name": "relative_tags_group",
      "description": "Target author is [SELF]; others get [U1], [U2] by first appearance in the kept context.",
      "channel_type": "group",
      "config": {},
      "history": [
        {
          "speaker_id": "p2",
          "text": "u got discord?"
        },
        {
          "speaker_id": "p1",
          "text": "ya"
        },
        {
          "speaker_id": "p3",
          "text": "same"
        },
        {
          "speaker_id": "p2",
          "text": "whats ur tag"
        }
      ],
      "target": {
        "speaker_id": "p1",
        "text": "shadowfox_22"
      },
      "expected": {
        "context_text": "[GROUP] [U1] u got discord? [SELF] ya [U2] same [U1] whats ur tag",
        "target_text": "shadowfox_22",
        "total_tokens": 17,
        "n_context_messages": 4,
        "n_speakers": 3
      }
    },
